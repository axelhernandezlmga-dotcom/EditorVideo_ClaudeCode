# Copiá este archivo a .env, o mejor corré `npm run claves` (te las pide ocultas y las prueba).
# También se cargan desde la app: Configuración → API Keys. .env no se sube a git.

# Voz principal: Google Gemini TTS (plan gratis con cupo diario) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: modelo de voz de Gemini
# GEMINI_TTS_MODELO=

# Fotos de stock para conceptos abstractos — https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Clips de stock — https://www.pexels.com/api/
PEXELS_API_KEY=
