{
  "name": "editor-video-claude-code",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Editor de video vertical con IA: de una idea o un video grabado a un reel listo para subir, con Claude Code y Remotion.",
  "author": "Accelerandes",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "claves": "tsx scripts/claves.ts",
    "start": "tsx src/server/index.ts --abrir",
    "dev": "tsx watch src/server/index.ts --dev",
    "video": "tsx src/cli/video.ts",
    "crudo": "tsx src/cli/crudo.ts",
    "capturas": "tsx src/cli/capturas.ts",
    "ideas": "tsx src/cli/ideas.ts",
    "studio": "remotion studio src/remotion/index.ts",
    "plantillas": "tsx src/cli/plantillas.ts",
    "movimiento": "tsx src/cli/movimiento.ts",
    "pruebas-voz": "tsx src/cli/pruebas-voz.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "musica": "tsx scripts/musica.ts",
    "build:web": "vite build",
    "ilustracion": "tsx src/cli/ilustracion.ts",
    "marca": "tsx src/cli/marca.ts",
    "biblioteca": "tsx src/cli/biblioteca.ts",
    "perfil": "tsx src/cli/perfil.ts",
    "publicar": "tsx scripts/publicar.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.6",
    "@remotion/bundler": "4.0.537",
    "@remotion/captions": "4.0.537",
    "@remotion/cli": "4.0.537",
    "@remotion/google-fonts": "4.0.537",
    "@remotion/install-whisper-cpp": "4.0.537",
    "@remotion/layout-utils": "4.0.537",
    "@remotion/media": "4.0.537",
    "@remotion/media-parser": "4.0.537",
    "@remotion/paths": "4.0.537",
    "@remotion/player": "4.0.537",
    "@remotion/renderer": "4.0.537",
    "@remotion/transitions": "4.0.537",
    "d3-geo": "3.1.1",
    "fastify": "5.12.7",
    "lucide-react": "1.61.0",
    "node-notifier": "11.0.0",
    "open": "11.0.4",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.537",
    "tsx": "4.23.15",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/d3-geo": "3.1.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
